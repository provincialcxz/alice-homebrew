{
  "format": 1,
  "id": "spotify-connect",
  "version": "1.0.0-beta.1",
  "api": 2,
  "engine": "native",
  "title": {
    "ru": "Spotify Connect",
    "en": "Spotify Connect"
  },
  "description": {
    "ru": "Колонка появляется в списке устройств Spotify. Звук идёт через штатный микшер Алисы. Нужен Spotify Premium.",
    "en": "The speaker shows up as a Spotify device. Audio plays through Alice's stock mixer. Spotify Premium is required."
  },
  "author": "Alice Homebrew",
  "permissions": [
    "system.full-access",
    "log.write"
  ],
  "capabilities": [
    "audio.playback",
    "network.listen",
    "network.multicast",
    "audio.analysis"
  ],
  "runtime_storage_bytes": 0,
  "module_sha256": "",
  "config": [
    {
      "key": "name",
      "label": {
        "ru": "Имя в Spotify",
        "en": "Spotify device name"
      },
      "type": "text",
      "default": "Alice Mini",
      "max_length": 32
    },
    {
      "key": "bitrate",
      "label": {
        "ru": "Качество звука",
        "en": "Audio quality"
      },
      "type": "select",
      "default": "160",
      "options": [
        {
          "value": "96",
          "label": {
            "ru": "Экономное, 96 кбит/с",
            "en": "Data saver, 96 kbps"
          }
        },
        {
          "value": "160",
          "label": {
            "ru": "Обычное, 160 кбит/с",
            "en": "Normal, 160 kbps"
          }
        },
        {
          "value": "320",
          "label": {
            "ru": "Высокое, 320 кбит/с",
            "en": "High, 320 kbps"
          }
        }
      ]
    },
    {
      "key": "initial-volume",
      "label": {
        "ru": "Громкость при подключении, %",
        "en": "Volume on connect, %"
      },
      "type": "range",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "key": "normalisation",
      "label": {
        "ru": "Выравнивать громкость треков",
        "en": "Normalise track loudness"
      },
      "type": "boolean",
      "default": false
    },
    {
      "key": "port",
      "label": {
        "ru": "Порт обнаружения",
        "en": "Discovery port"
      },
      "type": "range",
      "default": 4070,
      "min": 1024,
      "max": 65535,
      "step": 1
    }
  ]
}
