  "api": 3,
  "permissions": ["led.ring", "audio.levels", "input.buttons", "sensor.proximity"],
  "config": [
    {"key": "color", "label": {"ru": "Цвет", "en": "Color"}, "type": "color", "default": "#5ac8fa"},
    {"key": "brightness", "label": {"ru": "Яркость, %", "en": "Brightness, %"}, "type": "range", "default": 40, "min": 0, "max": 100, "step": 1},
    {"key": "near", "label": {"ru": "Порог датчика (единицы драйвера)", "en": "Sensor threshold (driver units)"}, "type": "range", "default": 100, "min": 10, "max": 1000, "step": 10}
  ],
  "module_sha256": ""
}
